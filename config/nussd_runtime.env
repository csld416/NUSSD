# Source this file from the repository root before launching PyTorchSim:
#
#   source config/nussd_runtime.env
#
# Change a 1 to 0 below to disable that feature for the current shell.

NUSSD_CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export NUSSD_ROOT="$(cd -- "${NUSSD_CONFIG_DIR}/.." && pwd)"

# Run weight DMA reads through LegoSim and the runtime SimpleSSD process.
export TOGSIM_LEGOSIM_SSD=1

# Reserved bandwidth for a future contention-free analytical SSD-link model,
# expressed as a numeric decimal GB/s value (8.0 means 8.0 GB/s). This setting
# is currently INACTIVE: the live SSD path models SimpleSSD service time and
# LegoSim synchronization, but no code yet converts this value into link delay,
# so changing it does not change today's simulated completion cycles.
#
# Once the analytical link is implemented, it should add approximately
# `request_bytes / bandwidth` to each SSD payload transfer (in addition to
# SimpleSSD's internal service time). The active PopNet link instead derives
# its bandwidth from the topology/clock/flit settings below.
export TOGSIM_LEGOSIM_SSD_BANDWIDTH_GBPS=8.0

# Enable the real phase-two PopNet model for the NPU--SSD link. This is
# effective only when TOGSIM_LEGOSIM_SSD=1. PopNet consumes the 64-byte read
# command and payload-sized response events emitted by the runtime protocol;
# its delay is fed back into the next LegoSim round and therefore contributes
# to the NPU-visible DMA completion cycle.
export TOGSIM_LEGOSIM_SSD_NOC=1

# PopNet runs after phase one, so round 1 discovers network delay and round 2+
# applies it. Keep this at 2 or greater; 3 gives one additional stability
# iteration and is the default used for validation.
export TOGSIM_LEGOSIM_SSD_NOC_ROUNDS=3

# UFS 4.0 raw-link baseline: the runtime bridge uses nanoseconds as LegoSim's
# common phase-one time unit. One 64-bit word per flit and 0.725 PopNet cycles
# per nanosecond give 8 bytes per 1.37931 ns, approximately 5.8 GB/s.
# The graph edge weight 5.075 corresponds to approximately 7 ns propagation.
export TOGSIM_LEGOSIM_SSD_POPNET_FLIT_WORDS=1
export TOGSIM_LEGOSIM_SSD_POPNET_CLOCK_RATE=0.725
export TOGSIM_LEGOSIM_SSD_POPNET_TOPOLOGY="${NUSSD_ROOT}/SimpleSSD-Standalone/topology/line_2_ufs4.gv"

# Emit the live request lifecycle consumed by monitor.sh. This is intended for
# demonstrations and debugging; disable it for performance experiments.
export NUSSD_PROTOCOL_TRACE=1

# Keep the existing DRAM-side LegoSim paths disabled for this SSD bridge demo.
export TOGSIM_LEGOSIM_DRAM=0
export TOGSIM_LEGOSIM_DRAM_NOC=0

# Repository locations used by the launcher.
export TORCHSIM_DIR="${NUSSD_ROOT}/PytorchSim-S"
export PYTORCHSIM_ROOT_PATH="${TORCHSIM_DIR}"
export SIMULATOR_ROOT="${NUSSD_ROOT}/LEGOSIM_MICRO"
# TOGSim is built out-of-tree so generated CMake files do not dirty the
# PytorchSim-S submodule's historically tracked TOGSim/build directory.
export TOGSIM_SIMULATOR_BIN="${NUSSD_ROOT}/build/togsim/bin/Simulator"
export SIMPLESSD_LEGOSIM_BIN="${NUSSD_ROOT}/SimpleSSD-Standalone/build/simplessd-legosim"
export SIMPLESSD_SIM_CONFIG="${NUSSD_ROOT}/SimpleSSD-Standalone/config/sample.cfg"
export SIMPLESSD_SSD_CONFIG="${NUSSD_ROOT}/SimpleSSD-Standalone/simplessd/config/sample_nocache.cfg"

# Runtime weight classification and logical SSD placement metadata. Python
# writes the active placement manifest before TOGSim is launched for a kernel.
export TOGSIM_SSD_TRACE_DIR="${NUSSD_ROOT}/runtime_metadata"
export TOGSIM_SSD_TRACE_NAME="runtime"
export TOGSIM_SSD_PLACEMENT_ALIGNMENT=4096

# Put generated TOGSim and protocol-monitor files in one predictable location.
export TORCHSIM_LOG_PATH="${NUSSD_ROOT}/runtime_results"
export TOGSIM_DEBUG_LEVEL=info

unset NUSSD_CONFIG_DIR
